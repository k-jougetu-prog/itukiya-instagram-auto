{
  "rewrites": [
    { "source": "/edit", "destination": "/edit.html" }
  ],
  "headers": [
    {
      "source": "/intro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/preview",
      "schedule": "0 4 * * 0,2,4"
    },
    {
      "path": "/api/cron/remind",
      "schedule": "0 8 * * 0,2,4"
    },
    {
      "path": "/api/cron/post",
      "schedule": "0 0 * * 1,3,5"
    },
    {
      "path": "/api/cron/refresh-token",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/insights-weekly",
      "schedule": "0 0 * * 1"
    }
  ],
  "functions": {
    "api/story-card.js": {
      "maxDuration": 30,
      "includeFiles": "public/story-overlay.png"
    },
    "api/cover.js": {
      "maxDuration": 30,
      "includeFiles": "public/fonts/*.ttf"
    },
    "api/edit.js": {
      "maxDuration": 30
    },
    "api/edit-data.js": {
      "maxDuration": 30
    },
    "api/cron/preview.js": {
      "maxDuration": 120,
      "includeFiles": "public/badges/*.png"
    },
    "api/cron/post.js": {
      "maxDuration": 300
    },
    "api/approve.js": {
      "maxDuration": 30
    },
    "api/cron/refresh-token.js": {
      "maxDuration": 60
    },
    "api/cron/insights-weekly.js": {
      "maxDuration": 120
    }
  }
}
